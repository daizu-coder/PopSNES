# Build outputs
pocketsnes*
*.o
*.a
*.so
*.dll
*.exe
*.map
CE/AppMain.exe

# UI font switch (make CE_FONT=...): comparison builds and the rebuild stamp
/CE/AppMain_shinonome.exe
/CE/AppMain_galmuri11.exe
.font-*

# Developer notes are not shipped; the READMEs and CE/LICENSING.md are.
*.md
!README.md
!/CE/LICENSING.md
!/CE/NOTES.md

# ROMs (never distributed)
*.sfc
*.smc
*.fig
*.swc
*.gd3
*.gd7
*.dx2
*.bin
*.zip
*.7z

# Save data, save states, screenshots
*.srm
*.state
*.state[0-9]
*.sav
Screenshots/

# Runtime config and logs written next to AppMain.exe
*.cfg
*.log

# Audio recordings used for sound-bug comparison (contain game audio)
*.wav

# Font files and DLLs are not part of this repository (the UI font is
# built into AppMain.exe, and the app needs no DLL beyond coredll)
jptahoma.ttc
*.ttc
gx.dll

# Windows "downloaded from the internet" provenance metadata (NTFS ADS
# materialised as real files under WSL)
*:Zone.Identifier

# Local tooling / IDE state
.vs/
.vscode/
.idea/
.claude/
*.user
*.suo
*.sqlite

# Backups
*.bak
*.orig
*.tmp
*~
backup/
backups/
*_backup/

# Mascot drawing sources (the build uses CE/icon/popsnes_mascot.bmp)
/CE/popsnes_mascot_*.png
/popsnes_mascot_*.png

# Original captures the README screenshots were converted from
/PreScreenshots/

# The app icon and the mascot bitmap in CE/icon/ are shipped
!/CE/icon/*.ico
!/CE/icon/*.bmp
# ...and the one mascot PNG shown at the top of .github/README.md
!/.github/images/popsnes_mascot_C_osanpo_4x.png
# ...and the README screenshots (see "Screenshots/" above: keep them even
# on a case-insensitive checkout)
!/.github/screenshots/
!/.github/screenshots/*.png
