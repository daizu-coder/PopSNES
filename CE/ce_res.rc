#include <windows.h>
#include "ce_resource.h"

/* App icon (16x16 + 32x32, 32bpp). IDI_MAIN is this file's lowest-numbered
 * (and only) ICON resource, so it is the one the shell shows for
 * AppMain.exe; ce_main.c also puts it on the window class with
 * LoadIconW(IDI_MAIN). Kept next to the mascot in CE/icon/. */
IDI_MAIN ICON "icon/popsnes.ico"

/* Main-menu mascot art blitted right of the hint text by
 * MainMenuDlgProc's WM_PAINT (ce_main.c). CE/icon/popsnes_mascot.bmp is
 * popsnes_mascot_C_osanpo.png (260x98) flattened onto the menu's
 * cream background (#F0E1BC) as 24bpp - this coredll has no
 * TransparentBlt/alpha blit, so the transparency is baked in. */
IDB_MAINMENU BITMAP  "icon/popsnes_mascot.bmp"

/* Touch-to-reveal "menu": plain DialogBoxW + PUSHBUTTON controls (see
 * ce_resource.h for why - this coredll doesn't export SetMenu). English
 * captions only: this .rc is compiled by windres and we have not
 * verified Japanese text survives that pipeline intact on this
 * toolchain, whereas the C-side wide string literals (MessageBoxW text
 * etc.) are confirmed working via \x-escaped UTF-16 - keep Japanese
 * strings there, not in resource scripts.
 *
 * Layout matches an earlier prototype's IDD_MAINMENU control-for-
 * control (same rects, same 210x140 size, ported per user request to be
 * "exactly the same"): Open ROM full width (WS_GROUP so Up/Down *wrap*
 * at the first/last button - see ce_resource.h), Save/Load State as a
 * 2-up row, the three config dialogs as a 3-up row in the same slot
 * the earlier prototype's Misc/Sound/Keys occupy, Exit full width, and a footer hint
 * line instead of a separate Resume/About button - resuming is just the
 * physical Back key (IDCANCEL), matching the earlier prototype exactly; there's no
 * equivalent slot for About in a 4-row layout, so it's gone too.
 * DS_CENTER dropped and WS_SYSMENU added (round 21, user request) to
 * match the earlier prototype's own dialogs pixel-for-pixel: positioned at its resource
 * x/y (0,0, i.e. the screen's top-left corner) instead of centered, with
 * a system "X" close box in the caption bar. That box isn't a dialog
 * control, so it never enters this dialog's physical-key focus chain;
 * tapping it delivers IDCANCEL the same way the physical Back key
 * already does (see MainMenuDlgProc's IDCANCEL case below), so no new
 * handling was needed for it to work.
 *
 * BS_OWNERDRAW on every PUSHBUTTON (this round): text is now drawn by
 * the Shinonome bitmap-font renderer (ce_bmpfont.c) via WM_DRAWITEM,
 * replacing the TrueType font + WM_SETFONT - see ce_lang.h/ce_bmpfont.h.
 *
 * Colorful rounded-button skin (ported from the sister PopSG port's
 * main menu, user request): same-row gaps widened from 4 to 8, the
 * Video/Sound/Input row grown from 20 to 34 tall for an icon-over-label
 * layout, and the dialog 140 -> 154 tall to fit. Colors/RoundRect()
 * drawing live in MainMenuDlgProc's WM_DRAWITEM/WM_ERASEBKGND
 * (ce_main.c, kMainMenuTheme). */
IDD_MAINMENU DIALOG 0, 0, 210, 154
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PopSNES"
FONT 9, "Tahoma"
BEGIN
    PUSHBUTTON "Open ROM...", IDC_MM_OPEN,       8,  8, 194, 20, WS_GROUP | WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "Save State",  IDC_MM_SAVESTATE,  8, 32,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Load State",  IDC_MM_LOADSTATE, 109, 32,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Video Cfg",   IDC_MM_VIDEO,      8, 56,  59, 34, BS_OWNERDRAW
    PUSHBUTTON "Sound Cfg",   IDC_MM_SOUND,     75, 56,  60, 34, BS_OWNERDRAW
    PUSHBUTTON "Input Cfg",   IDC_MM_INPUT,    143, 56,  59, 34, BS_OWNERDRAW
    PUSHBUTTON "Screenshot",  IDC_MM_SCREENSHOT, 8, 94,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Exit",        IDC_MM_EXIT,     109, 94,  93, 20, BS_OWNERDRAW
    LTEXT "Press Back to resume the game.", IDC_MM_HINT, 8, 122, 194, 20
END

/* Two columns (D-pad/Select/Start on the left, A/B/X/Y/L/R on the
 * right) of label + remap-button pairs, plus a footer row - see
 * ce_input.c for the remap-by-press logic and ce_resource.h for why
 * this is a plain DialogBox like IDD_MAINMENU. Width unified to 190 to
 * match every other settings/picker dialog (user request); height
 * stays whatever this content needs (12 remap buttons vs. e.g. Sound
 * Config's 4 rows - a straight 190x104 match isn't physically possible
 * here, unlike the other three dialogs). No Cancel button - see
 * IDD_SOUNDCONFIG's comment on why; WS_GROUP on the first remap button
 * makes Up/Down wrap through OK and back, same mechanism as
 * IDD_MAINMENU above. No Reset to Defaults button any more (round 21,
 * user request) - OK's size/position now matches every other dialog's
 * own OK (50x14, centered). DS_CENTER dropped and WS_SYSMENU added
 * (round 21) - see IDD_MAINMENU's comment above for why. */
/* All sixteen rows (Up/Down/Left/Right, the four diagonal combos, and
 * Select/Start/A/B/X/Y/L/R) share one label width (32) and one remap
 * button width (48) - user request, replacing the old mix of a 60-wide
 * button with 32-wide label on the left column, a 64-wide button with
 * 14-wide label on the right column, and an even wider 44-wide label
 * for Select/Start alone. Left column: Up/Down/Left/Right then the
 * four diagonal combo buttons. Right column: A/B/X/Y/L/R followed by
 * Select/Start at the bottom (moved there from the top of the column
 * in an earlier pass - user request). Row pitch is 17 (not
 * the 20 the original six-row layout used) and button height 14 (not
 * 16) - eight rows at the old 20/16 proportions pushed the dialog to
 * 200 tall and clipped OK off the bottom on real hardware (user
 * report); 190x170 here matches this same dialog's own previously
 * hardware-verified six-row size exactly, just repacked tighter to fit
 * two more rows in the same footprint. See ce_input.c's kInputOrder for
 * the matching physical-key focus order (now a single Up/Down/Left/
 * Right-agnostic loop through left column -> right column -> OK, not a
 * two-axis grid - user report: the old per-column Up/Down + Left/Right-
 * swap scheme left the right column unreachable on this hardware).
 *
 * Every LTEXT here (including the A/B/X/Y/L/R and diagonal-combo
 * captions, which stay untranslated even in Japanese mode) now has a
 * real ID, not -1 - the bitmap-font port hides *every* label and
 * repaints it via CeBmpFontPaintLabel(), which needs GetDlgItem() to
 * find it, not just the subset that changes text between languages
 * (see ce_resource.h's IDC_IC_LBL_A and friends). PUSHBUTTONs gain
 * BS_OWNERDRAW for the same reason as IDD_MAINMENU above. */
IDD_INPUTCONFIG DIALOG 0, 0, 190, 170
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Input Config"
FONT 9, "Tahoma"
BEGIN
    /* 2026-09-27 (PopPCE と同じ変更): remap buttons widened to 54 - the
     * Galmuri14 font's "Press key"/"Backspace" overflowed 48 on real
     * hardware (PopPCE). The dialog width is unchanged; the gaps between
     * the columns and the right margin were narrowed instead. */
    LTEXT     "Up",       IDC_IC_LBL_UP,      6,  9, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_UP,     40,  8, 54, 14, WS_GROUP | WS_TABSTOP | BS_OWNERDRAW
    LTEXT     "A",        IDC_IC_LBL_A,      98,  9, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_A,     132,  8, 54, 14, BS_OWNERDRAW

    LTEXT     "Down",     IDC_IC_LBL_DOWN,    6, 26, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_DOWN,   40, 25, 54, 14, BS_OWNERDRAW
    LTEXT     "B",        IDC_IC_LBL_B,      98, 26, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_B,     132, 25, 54, 14, BS_OWNERDRAW

    LTEXT     "Left",     IDC_IC_LBL_LEFT,    6, 43, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_LEFT,   40, 42, 54, 14, BS_OWNERDRAW
    LTEXT     "X",        IDC_IC_LBL_X,      98, 43, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_X,     132, 42, 54, 14, BS_OWNERDRAW

    LTEXT     "Right",    IDC_IC_LBL_RIGHT,   6, 60, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_RIGHT,  40, 59, 54, 14, BS_OWNERDRAW
    LTEXT     "Y",        IDC_IC_LBL_Y,      98, 60, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_Y,     132, 59, 54, 14, BS_OWNERDRAW

    /* Diagonal combos - ASCII captions here are the English text;
     * ApplyInputConfigLanguage() swaps them for 右上/右下/左下/左上 in
     * Japanese mode (user request). */
    LTEXT     "Up R",     IDC_IC_LBL_UPRIGHT,    6, 77, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_UPRIGHT, 40, 76, 54, 14, BS_OWNERDRAW
    LTEXT     "L",        IDC_IC_LBL_L,         98, 77, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_L,      132, 76, 54, 14, BS_OWNERDRAW

    LTEXT     "R Down",   IDC_IC_LBL_RIGHTDOWN,   6, 94, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_RIGHTDOWN,40, 93, 54, 14, BS_OWNERDRAW
    LTEXT     "R",        IDC_IC_LBL_R,          98, 94, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_R,        132, 93, 54, 14, BS_OWNERDRAW

    /* Select/Start moved to the bottom of the right column (user
     * request, replacing the earlier top-of-column placement). */
    LTEXT     "Down L",   IDC_IC_LBL_DOWNLEFT,    6,111, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_DOWNLEFT, 40,110, 54, 14, BS_OWNERDRAW
    /* Select/Start labels sit 3 DLU left of the other right-column
     * labels (x=93 vs. 96) - user request: the Japanese captions
     * ("セレクト"/"スタート", 4 full-width glyphs) are wider than the
     * A/B/X/Y/L/R letters and read better nudged left. Only the label
     * moves; the remap button stays put. */
    LTEXT     "Select",   IDC_IC_LBL_SELECT,   98,111, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_SELECT,  132,110, 54, 14, BS_OWNERDRAW

    LTEXT     "L Up",     IDC_IC_LBL_LEFTUP,      6,128, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_LEFTUP,   40,127, 54, 14, BS_OWNERDRAW
    LTEXT     "Start",    IDC_IC_LBL_START,    98,128, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_START,   132,127, 54, 14, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",                IDOK,          70, 147,  50, 14, BS_OWNERDRAW
END

/* Volume/Rate/Bits/Quality are all "-/value/+" spinners now (ported
 * from an earlier prototype's own Sound Settings dialog, per user
 * request), not a COMBOBOX + RADIOBUTTON pairs - the value lives on a
 * WS_TABSTOP PUSHBUTTON in the middle so it gets a native focus
 * rectangle and a place in the physical-key Up/Down/Left/Right loop
 * (see ce_audio.c's SoundConfigDlgProc/SoundCtrlProc); the "-"/"+"
 * buttons on either side are touch-only (no WS_TABSTOP), matching
 * the earlier prototype's IDC_FRAMESKIP_MINUS/PLUS. The separate Mute checkbox is gone
 * too - Volume all the way down to 0 already silences output (same
 * design as the earlier prototype's Volume 0..10 replacing its old "No Sound" radio
 * choice), so a second, redundant control for the same thing didn't
 * carry over. No Cancel button: this device has no meaningful "discard
 * changes" gesture, only "go back" - the physical Back key (IDCANCEL)
 * commits and closes exactly like OK does (see SoundConfigDlgProc). This
 * dialog is now exactly 190x104, matching every settings/picker dialog
 * the earlier prototype has (Misc/Sound/Keys/ROM picker all share that footprint there
 * too) - same OK position (70,86,50,14) as this project's own Video
 * Config/ROM picker. DS_CENTER dropped and WS_SYSMENU added (round 21)
 * - see IDD_MAINMENU's comment above for why. No CHECKBOX controls in
 * this dialog, so BS_OWNERDRAW (below) is a plain PUSHBUTTON-only
 * change here - see IDD_VIDEOCONFIG's comment for the CHECKBOX pitfall
 * that doesn't apply in this file. All five rows' "-" buttons share
 * one x (53) and all five value buttons share one x (68), so the
 * spinner columns line up under each other regardless of how wide the
 * "Volume:"/"Rate:"/"Bits:"/... label to their left is (user request). */
IDD_SOUNDCONFIG DIALOG 0, 0, 190, 121
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sound Config"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "Volume:",  IDC_SC_LBL_VOLUME,     8,  9, 44,  8
    PUSHBUTTON "-",        IDC_SC_VOLUME_MINUS,  53,  7, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "10",       IDC_SC_VOLUME_VALUE,  68,  6, 20, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_VOLUME_PLUS,   89,  7, 14, 12, BS_OWNERDRAW

    LTEXT      "Rate:",    IDC_SC_LBL_RATE,       8, 26, 30,  8
    PUSHBUTTON "-",        IDC_SC_RATE_MINUS,    53, 24, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "Native",   IDC_SC_RATE_VALUE,    68, 23, 60, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_RATE_PLUS,    129, 24, 14, 12, BS_OWNERDRAW

    LTEXT      "Bits:",    IDC_SC_LBL_BITS,       8, 42, 30, 10
    PUSHBUTTON "-",        IDC_SC_BITS_MINUS,    53, 41, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "16-bit",   IDC_SC_BITS_VALUE,    68, 40, 63, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_BITS_PLUS,    132, 41, 14, 12, BS_OWNERDRAW

    LTEXT      "Quality:", IDC_SC_LBL_QUALITY,    8, 59, 34, 10
    PUSHBUTTON "-",        IDC_SC_QUALITY_MINUS, 53, 58, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "Smooth",   IDC_SC_QUALITY_VALUE, 68, 57, 63, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_QUALITY_PLUS, 132, 58, 14, 12, BS_OWNERDRAW

    LTEXT      "Buffer:",  IDC_SC_LBL_BUFFER,     8, 76, 34, 10
    PUSHBUTTON "-",        IDC_SC_BUFFER_MINUS,  53, 75, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "8 KB",     IDC_SC_BUFFER_VALUE,  68, 74, 63, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_BUFFER_PLUS,  132, 75, 14, 12, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",    IDOK,                  70, 103, 50, 14, BS_OWNERDRAW
END

/* Scale (see CeScaleMode in ce_video.h for what each of the 4 modes
 * does), Transparency Effects, Frame Skip (a "-/value/+" spinner, same
 * reasoning as Sound Config's rows above) and the English/Japanese
 * toggle - this project's closest analogue to the earlier prototype's Misc dialog. Its
 * Open Last Folder checkbox was removed (the picker now always reopens
 * the last folder, see ce_fileopen.c), shrinking the dialog 132 -> 118. Scale was a 2x2
 * RADIOBUTTON grid until round 21 (user request); now a single
 * "-/value/+" spinner cycling through 4 states displayed as
 * x1/x1.5/Wide/Full (see ce_video.c's kScaleOrder/kScaleLabels), same
 * pattern as Frame Skip below and Sound Config's Volume/Rate/Bits/
 * Quality. The "Enable Debug Logging" checkbox (round after 27, user
 * request) is the bottom row above OK, same BS_OWNERDRAW checkbox
 * treatment as Transparency Effects; it drives
 * CeLogSetEnabled() (ce_log.h), persisted as "VideoDebugLog", default
 * off - the dialog grew 116 -> 132 to fit it. The English/Japanese control is a "-/value/+" spinner
 * too (round 25, ported from the reference sample), showing the current
 * language name ("English" / "日本語") - was a fixed "English" CHECKBOX.
 * No Cancel button - see IDD_SOUNDCONFIG's comment
 * above. Width unified to 190 like every other settings/picker dialog.
 * DS_CENTER dropped and WS_SYSMENU added (round 21) - see
 * IDD_MAINMENU's comment above for why.
 *
 * BS_OWNERDRAW added to every PUSHBUTTON and every CHECKBOX here. A RC
 * CHECKBOX's implied BS_CHECKBOX (2) and BS_OWNERDRAW
 * (0x0B) both live in the low-nibble "button type" field, so ORing them
 * collapses to BS_OWNERDRAW alone - BM_GETCHECK/BM_SETCHECK/
 * CheckDlgButton() stop reporting/setting checked state once this is
 * added. ce_video.c's VideoConfigDlgProc/VideoCtrlProc were changed to
 * track IDC_VC_TRANSPARENCY's checked state in a plain app-side bool
 * instead and draw the check mark explicitly via
 * CeBmpFontDrawOwnerCheckbox() from WM_DRAWITEM - see that file.
 * (IDC_VC_JAPANESE is a spinner value readout now, not a checkbox -
 * it reads CeLangIsJapanese() directly.) */
IDD_VIDEOCONFIG DIALOG 0, 0, 190, 118
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Video Config"
FONT 9, "Tahoma"
BEGIN
    LTEXT       "Scale:",       IDC_VC_LBL_SCALE,       8,  9, 30,  8
    PUSHBUTTON  "-",            IDC_VC_SCALE_MINUS,     45,  7, 14, 12, BS_OWNERDRAW
    PUSHBUTTON  "x1",           IDC_VC_SCALE_VALUE,     60,  6, 40, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",            IDC_VC_SCALE_PLUS,      101,  7, 14, 12, BS_OWNERDRAW

    CHECKBOX    "Transparency Effects", IDC_VC_TRANSPARENCY,  8, 24, 160, 12, BS_OWNERDRAW

    LTEXT       "Frame Skip:",  IDC_VC_LBL_FRAMESKIP,   8, 42,  90, 12
    PUSHBUTTON  "-",            IDC_VC_FRAMESKIP_DOWN, 100, 40,  14, 12, BS_OWNERDRAW
    PUSHBUTTON  "Off",          IDC_VC_FRAMESKIP_LABEL,116, 39,  26, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",            IDC_VC_FRAMESKIP_UP,   144, 40,  14, 12, BS_OWNERDRAW

    PUSHBUTTON  "-",            IDC_VC_LANG_MINUS,        8, 60,  14, 12, BS_OWNERDRAW
    PUSHBUTTON  "English",      IDC_VC_JAPANESE,         24, 59, 120, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",            IDC_VC_LANG_PLUS,       146, 60,  14, 12, BS_OWNERDRAW

    CHECKBOX    "Enable Debug Logging", IDC_VC_DEBUGLOG, 8, 74, 160, 12, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",  IDOK,                          70, 94, 50, 14, BS_OWNERDRAW
END

/* Custom ROM picker (see ce_fileopen.c) - replaces GetOpenFileNameW(),
 * ported to match an earlier prototype's own IDD_FILEOPEN/
 * DLGFileOpen as closely as possible (same field layout; WS_SYSMENU
 * added here, unlike this project's other dialogs, to match its "X"
 * close box - DS_CENTER kept from this project's own convention since
 * it's already proven reliable here, whereas the earlier prototype's version doesn't use
 * it). Folder-list + up-navigation ("<" as the first entry, not a real
 * file/folder) only, driven by the physical direction keys and the
 * decide/cancel keys - decide enters a folder or picks a file, cancel
 * goes up a folder or closes the picker at the root. Resized to 190x104
 * (from 200x130, user request) to match every settings/picker dialog
 * exactly, same OK position (70,86,50,14) as Sound/Video Config.
 *
 * IDC_FO_LIST gains LBS_OWNERDRAWFIXED | LBS_HASSTRINGS this round (the
 * latter is required alongside the former - without it LB_GETTEXT comes
 * back empty even though selection/scrolling still look fine) so its
 * rows can be drawn with the Shinonome bitmap font via WM_MEASUREITEM/
 * WM_DRAWITEM (see ce_fileopen.c) instead of relying on WM_SETFONT. */
IDD_FILEOPEN DIALOG 0, 0, 190, 108
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select ROM"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "",       IDC_FO_PATH, 6, 4, 178, 10
    /* Height 64 (not 66): at 66 the last row this box can show came out
     * partially clipped on real hardware (a lesson from the
     * reference template), and ce_fileopen.c's Left/Right paging assumes
     * a whole number of visible rows (CE_FILELIST_PAGE_SIZE). */
    /* 2026-09-27 (PopPCE と同じ変更): list 64 -> 68, dialog 104 -> 108,
     * OK 86 -> 90 - with the Galmuri14 font's 19px rows the 6th row came
     * out cut off on real hardware (PopPCE). */
    LISTBOX               IDC_FO_LIST, 6, 16, 178, 68, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK",   IDOK,        70, 90, 50, 14, BS_OWNERDRAW
END

/* Small Japanese-capable message dialog (new this round) - see
 * ce_resource.h's IDD_MSGBOX/IDC_MB_TEXT comment and CeShowMsgBox()/
 * MsgBoxDlgProc() in ce_main.c. IDC_MB_TEXT starts empty; CeShowMsgBox()
 * fills it in before showing the dialog and MsgBoxDlgProc() immediately
 * hides it and repaints it word-wrapped via the bitmap-font renderer,
 * same hide+WM_PAINT pattern as every other dialog's labels. */
IDD_MSGBOX DIALOG 0, 0, 200, 64
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PopSNES"
FONT 9, "Tahoma"
BEGIN
    LTEXT         "",   IDC_MB_TEXT, 8, 5, 184, 38
    DEFPUSHBUTTON "OK", IDOK,        75, 44, 50, 14, BS_OWNERDRAW
END

/* Yes/No confirmation (user request - Save State asks first). Copied
 * verbatim from the gnuboy CE port's IDD_CONFIRM: same self-drawn
 * Shinonome-bitmap-font design as IDD_MSGBOX above; two BS_OWNERDRAW
 * buttons with custom IDs (IDC_CF_YES/IDC_CF_NO) drawn and key-handled
 * by ce_main.c's ConfirmDlgProc/ConfirmBtnCtrlProc. */
IDD_CONFIRM DIALOG 0, 0, 134, 70
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PopSNES"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "",      IDC_CF_TEXT, 8, 8, 118, 36
    DEFPUSHBUTTON "Yes", IDC_CF_YES, 18, 48, 45, 14, BS_OWNERDRAW
    PUSHBUTTON    "No",  IDC_CF_NO,  71, 48, 45, 14, BS_OWNERDRAW
END
